================================================================================
FLUJO COMPLETO PWA <-> SLiMS (verificado logicamente)
================================================================================

  1. INICIO DE SESION DE SOCIA
     PWA -> POST /api/verify-member { member_id }
       -> server.ts -> GET SLiMS /member/{id}/verify   <- AHORA FUNCIONA
       <- SLiMS -> { status: "success", data: { member_name, ... } }

  2. PRESTAMO DE LIBRO
     PWA -> POST /api/perform-action { accion: "prestamo", asin, id_socia }
       -> server.ts normaliza -> POST SLiMS /loan/borrow { member_id, item_code } <- AHORA FUNCIONA
       <- SLiMS -> { status: "success", data: { loan_id, due_date, ... } }

  3. DEVOLUCION DE LIBRO
     PWA -> POST /api/perform-action { accion: "devolucion", asin }
       -> server.ts normaliza -> POST SLiMS /loan/return { item_code }  <- AHORA FUNCIONA
       <- SLiMS -> { status: "success", data: { loan_id, return_date, ... } }

  4. BUSQUEDA EN CATALOGO
     PWA -> GET /api/catalog-proxy?q={termino}
       -> server.ts -> GET SLiMS /biblio/search?q={termino}  <- AHORA FUNCIONA
       <- SLiMS -> [{ title, author, isbn, is_available, ... }]

